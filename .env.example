# Backend (copy relevant values to backend/.env)
APP_ENV=development
DATABASE_URL=
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=
UPLOAD_MAX_IMAGE_SIZE_BYTES=10485760
UPLOAD_QUOTA_LIMIT=30
UPLOAD_QUOTA_WINDOW_HOURS=24
UPLOAD_PENDING_LIFETIME_HOURS=24
UPLOAD_SAS_LIFETIME_MINUTES=10
AZURE_SERVICE_BUS_NAMESPACE=
AZURE_SERVICE_BUS_QUEUE=
AZURE_SERVICE_BUS_GENERATION_QUEUE=
FAL_KEY=
RECONSTRUCTION_POLL_INTERVAL_SECONDS=10
RECONSTRUCTION_MAX_RUNTIME_MINUTES=20
RECONSTRUCTION_MAX_MODEL_SIZE_BYTES=104857600
RECONSTRUCTION_SOURCE_SAS_LIFETIME_MINUTES=25
RECONSTRUCTION_HTTP_TIMEOUT_SECONDS=30
CORS_ORIGINS=["http://localhost:5173"]

# Frontend (copy relevant values to frontend/.env)
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_UPLOAD_MAX_IMAGE_SIZE_BYTES=10485760
VITE_UPLOAD_MAX_PIXEL_COUNT=40000000

